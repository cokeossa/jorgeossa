---
// Panel de ajuste de diseño. Solo aparece en la vista previa local (npm run dev),
// nunca en el sitio publicado. Mueve las variables de src/styles/global.css;
// los valores elegidos se pasan a mano a ese archivo.
const controls = [
  { group: 'Grilla' },
  { v: '--columns', label: 'Columnas', min: 1, max: 6, unit: '' },
  { v: '--cover-ratio', label: 'Proporción', options: ['3 / 2', '4 / 3', '16 / 9', '5 / 4', '1 / 1', '4 / 5', '2 / 3'] },
  { v: '--cover-size', label: 'Tamaño fotos', min: 30, max: 100, unit: '%' },
  { v: '--margin', label: 'Margen lateral', min: 0, max: 240 },
  { v: '--gap', label: 'Espacio entre fotos', min: 0, max: 160 },
  { v: '--row-gap', label: 'Espacio entre filas', min: 0, max: 240 },
  { v: '--title-gap', label: 'Foto → nombre', min: 0, max: 48 },
  { v: '--strip-height', label: 'Alto fotos (Photography)', min: 200, max: 900 },
  { v: '--strip-gap', label: 'Espacio fotos (Photography)', min: 0, max: 80 },
  { group: 'Tipografía' },
  { v: '--logo-size', label: 'JOS', min: 12, max: 72 },
  { v: '--text-size', label: 'Menú y textos', min: 9, max: 24 },
  { v: '--title-size', label: 'Nombres', min: 9, max: 24 },
  { v: '--filter-size', label: 'Filtros', min: 8, max: 20 },
  { group: 'Header' },
  { v: '--header-top', label: 'Aire arriba', min: 0, max: 160 },
  { v: '--logo-gap', label: 'JOS → menú', min: 0, max: 400 },
  { v: '--menu-gap', label: 'Entre ítems menú', min: 0, max: 160 },
  { v: '--header-bottom', label: 'Header → filtros', min: 0, max: 200 },
  { v: '--filters-bottom', label: 'Filtros → grilla', min: 0, max: 160 },
];
---

<div id="tp" class="tp">
  <div class="tp-head">
    <strong>Panel de ajuste</strong>
    <span>
      <button type="button" data-act="guides">Ver grilla</button>
      <button type="button" data-act="toggle">–</button>
    </span>
  </div>
  <div class="tp-body">
    {controls.map((c) =>
      'group' in c ? (
        <p class="tp-group">{c.group}</p>
      ) : (
        <label class="tp-row">
          <span>{c.label}</span>
          {c.options ? (
            <select data-var={c.v}>{c.options.map((o) => <option value={o}>{o.replace(/ /g, '')}</option>)}</select>
          ) : (
            <input type="range" data-var={c.v} min={c.min} max={c.max} step="1" data-unit={c.unit ?? 'px'} />
          )}
          <output></output>
        </label>
      ),
    )}
    <p class="tp-group">Un proyecto</p>
    <label class="tp-row">
      <span>Proyecto</span>
      <select id="tp-item" style="grid-column: span 2"></select>
    </label>
    <label class="tp-row">
      <span>Su tamaño</span>
      <input type="range" id="tp-item-size" min="30" max="100" step="1" />
      <output></output>
    </label>
    <div class="tp-actions">
      <button type="button" data-act="copy">Copiar valores</button>
      <button type="button" data-act="reset">Volver al inicio</button>
    </div>
  </div>
</div>

<div class="tp-guides" aria-hidden="true"></div>

<style is:global>
  /* Guías: columnas y márgenes dibujados sobre la página */
  .tp-guides {
    position: fixed; inset: 0; z-index: 999; pointer-events: none; display: none;
    padding: 0 var(--margin);
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr)); column-gap: var(--gap);
  }
  .tp-guides span { background: rgba(255, 0, 80, 0.07); border-left: 1px solid rgba(255, 0, 80, 0.5); border-right: 1px solid rgba(255, 0, 80, 0.5); }
  .tp-show-guides .tp-guides { display: grid; }
  .tp-show-guides .grid li { outline: 1px dashed rgba(255, 0, 80, 0.6); }
  .tp-show-guides .header, .tp-show-guides .filters { outline: 1px dashed rgba(0, 120, 255, 0.5); }
  .tp button.on { background: #000; color: #fff; }
  .tp {
    position: fixed; right: 12px; bottom: 12px; z-index: 1000; width: 280px;
    max-height: calc(100vh - 24px); overflow: auto;
    background: #fff; border: 1px solid #000; padding: 10px 12px;
    font: 11px/1.3 -apple-system, system-ui, sans-serif; color: #000;
  }
  .tp-head { display: flex; justify-content: space-between; align-items: center; }
  .tp button { font: inherit; background: #fff; border: 1px solid #000; padding: 3px 8px; cursor: pointer; }
  .tp.closed .tp-body { display: none; }
  .tp-group { margin: 12px 0 4px; color: #8a8a8a; text-transform: uppercase; letter-spacing: 0.08em; }
  .tp-row { display: grid; grid-template-columns: 100px 1fr 40px; align-items: center; gap: 6px; margin: 3px 0; }
  .tp-row input { width: 100%; accent-color: #000; }
  .tp-row select { font: inherit; }
  .tp-row output { text-align: right; font-variant-numeric: tabular-nums; }
  .tp-actions { display: flex; gap: 6px; margin-top: 12px; }
</style>

<script is:inline>
  (() => {
    const KEY = 'jos-panel';
    const root = document.documentElement;
    const panel = document.getElementById('tp');
    let saved = {};
    try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}

    const fields = panel.querySelectorAll('[data-var]');
    const unitOf = (el) => (el.tagName === 'SELECT' ? '' : el.dataset.unit);
    const show = (el) => (el.nextElementSibling.textContent = el.value + (el.tagName === 'SELECT' ? '' : unitOf(el)));

    // Solo se fijan los valores que se movieron; el resto sigue el diseño normal.
    for (const [v, val] of Object.entries(saved)) if (v.startsWith('--')) root.style.setProperty(v, val);

    fields.forEach((el) => {
      const current = getComputedStyle(root).getPropertyValue(el.dataset.var).trim();
      el.value = el.tagName === 'SELECT' ? current : parseFloat(current);
      show(el);
      el.addEventListener('input', () => {
        const val = el.value + unitOf(el);
        root.style.setProperty(el.dataset.var, val);
        saved[el.dataset.var] = val;
        localStorage.setItem(KEY, JSON.stringify(saved));
        show(el);
      });
    });

    // Tamaño de un proyecto en particular (se guarda como 'item:<slug>')
    const items = [...document.querySelectorAll('.grid li[data-slug]')];
    const pick = document.getElementById('tp-item');
    const size = document.getElementById('tp-item-size');
    const itemSize = (li) => {
      const own = li.style.getPropertyValue('--item-size');
      return parseFloat(own || getComputedStyle(root).getPropertyValue('--cover-size'));
    };
    items.forEach((li) => {
      const val = saved['item:' + li.dataset.slug];
      if (val) li.style.setProperty('--item-size', val);
      pick.add(new Option(li.querySelector('.title').textContent, li.dataset.slug));
    });
    const current = () => items.find((li) => li.dataset.slug === pick.value);
    const syncItem = () => {
      if (!current()) return;
      size.value = itemSize(current());
      size.nextElementSibling.textContent = size.value + '%';
    };
    pick.addEventListener('change', syncItem);
    size.addEventListener('input', () => {
      const val = size.value + '%';
      current().style.setProperty('--item-size', val);
      saved['item:' + pick.value] = val;
      localStorage.setItem(KEY, JSON.stringify(saved));
      size.nextElementSibling.textContent = val;
    });
    // Al mover "Tamaño fotos", el selector individual muestra el valor actualizado
    panel.querySelector('[data-var="--cover-size"]').addEventListener('input', syncItem);
    syncItem();
    if (!items.length) pick.closest('label').parentElement.querySelectorAll('#tp-item, #tp-item-size').forEach((el) => (el.disabled = true));

    // Guías de grilla: una franja por columna, se actualizan solas al mover los controles
    const guides = document.querySelector('.tp-guides');
    const guidesBtn = panel.querySelector('[data-act="guides"]');
    const drawGuides = () => {
      const n = parseInt(getComputedStyle(root).getPropertyValue('--columns'));
      if (guides.children.length !== n) guides.replaceChildren(...Array.from({ length: n }, () => document.createElement('span')));
    };
    const setGuides = (on) => {
      root.classList.toggle('tp-show-guides', on);
      guidesBtn.classList.toggle('on', on);
      guidesBtn.textContent = on ? 'Ocultar grilla' : 'Ver grilla';
      drawGuides();
      try { localStorage.setItem(KEY + '-guides', on ? '1' : ''); } catch {}
    };
    setGuides(localStorage.getItem(KEY + '-guides') === '1');
    panel.addEventListener('input', drawGuides);
    addEventListener('resize', drawGuides);

    panel.addEventListener('click', (e) => {
      const act = e.target.dataset?.act;
      if (act === 'guides') setGuides(!root.classList.contains('tp-show-guides'));
      if (act === 'toggle') {
        panel.classList.toggle('closed');
        e.target.textContent = panel.classList.contains('closed') ? '+' : '–';
      }
      if (act === 'reset') {
        localStorage.removeItem(KEY);
        location.reload();
      }
      if (act === 'copy') {
        const perItem = Object.entries(saved).filter(([k]) => k.startsWith('item:')).map(([k, v]) => `${k.slice(5)}: ${v}`);
        const text = [...fields].map((el) => `${el.dataset.var}: ${el.value}${unitOf(el)};`).concat(perItem).join('\n');
        navigator.clipboard.writeText(`Ancho de pantalla: ${innerWidth}px\n${text}`);
        e.target.textContent = 'Copiado ✓';
        setTimeout(() => (e.target.textContent = 'Copiar valores'), 1500);
      }
    });
  })();
</script>
