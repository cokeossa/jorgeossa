---
// About: retrato fijo a la izquierda; a la derecha el texto y las credenciales, que es lo único
// que se desplaza (inspirado en cesarpesquera.com/about). En celular, todo en una columna.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { IMAGE_QUALITY } from '../site';
import retrato from '../assets/retrato.jpg';

// Texto de presentación, en tercera persona (ideas de JOS, redactado con Claude).
// Acepta links (<a href="...">texto</a>) y negrita (<strong>texto</strong>). "espacio blanco" va en minúsculas y "PINOT" en mayúsculas.
const bio = [
  'Jorge Ossa Silva (JOS) is a multidisciplinary artist based in Santiago, Chile, working across creative direction, video and photography. His work moves between long-term personal series and commercial projects, and it always starts from the same place: paying attention to what is in front of him.',
  'Life is a series of moments, and the camera is how he keeps them. After a year in Barcelona finishing his master’s, he came back to keep building documentary projects like Palma Chilena, while directing and shooting film and photography for others.',
  'With a background in business engineering, Jorge brings a strategic eye to every project, which helps him understand, beyond the brief, what a brand is really looking for. Today he is also co-founder of espacio blanco, a creative studio based in Santiago, and of <a href="https://www.pinotgallery.com" target="_blank" rel="noopener"><strong>PINOT</strong></a>, a gallery specializing in fine art photography prints, also based in Chile.',
];

// Credenciales. Una sección sin ítems no se muestra (ej. Clients, mientras se define).
const sections = [
  { title: 'Exhibitions', items: ['2026 — “Paisaje y Naturaleza”, Factoría Franklin'] },
  {
    title: 'Awards',
    items: ['2025 — ADG Laus Gold, Brand Strategy', '2024 — ADG Laus Silver, Advertising'],
  },
  { title: 'Collaborations', items: ['Sin Título 1 Design Studio'] },
  { title: 'Clients', items: [] },
  {
    title: 'Education',
    items: [
      'Master’s Degree in Creative Direction and Design in Communication Strategies — Elisava, Barcelona, Spain',
      'Documentary Photography — Fotodesign Chile',
      'Business Engineering — Universidad Andrés Bello, Santiago, Chile',
    ],
  },
].filter((s) => s.items.length > 0);
---

<Base title="About">
  <div class="about">
    <div class="about-photo">
      <Image
        src={retrato}
        alt="Jorge Ossa Silva"
        quality={IMAGE_QUALITY}
        widths={[600, 900, 1300, 1666]}
        sizes="(min-width: 800px) 40vw, 100vw"
        loading="eager"
      />
    </div>

    <div class="about-info">
      <div class="about-bio">
        {bio.map((p) => <p set:html={p} />)}
      </div>
      {sections.map((s) => (
        <section>
          <h2>{s.title}</h2>
          <ul>{s.items.map((item) => <li>{item}</li>)}</ul>
        </section>
      ))}
    </div>
  </div>
</Base>

<script>
  // En computador, la rueda sobre la foto también desplaza la columna de información
  const info = document.querySelector<HTMLElement>('.about-info');
  document.querySelector('.about-photo')?.addEventListener(
    'wheel',
    (e) => {
      if (!info || info.scrollHeight <= info.clientHeight) return;
      e.preventDefault();
      info.scrollTop += (e as WheelEvent).deltaY;
    },
    { passive: false },
  );
</script>
