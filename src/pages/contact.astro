---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
---

<Base title="Contact">
  <ul>
    {SITE.email && <li>{SITE.email}</li>}
    {SITE.instagram && <li><a href={SITE.instagram}>Instagram</a></li>}
    {SITE.vimeo && <li><a href={SITE.vimeo}>Vimeo</a></li>}
    <li class="muted">{SITE.city}</li>
  </ul>
</Base>
