---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Grid from '../../components/Grid.astro';

const projects = (await getCollection('personal', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<Base title="Personal">
  {projects.length > 0 ? <Grid entries={projects} base="/personal" /> : <p class="empty">Proyectos en carga.</p>}
</Base>
