---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Grid from '../../components/Grid.astro';
import Filters from '../../components/Filters.astro';
import { PERSONAL_FILTERS } from '../../site';

const projects = (await getCollection('personal', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || (b.data.year ?? 0) - (a.data.year ?? 0),
);
---

<Base title="Personal">
  <Filters filters={PERSONAL_FILTERS} label="Proyectos personales" />
  {projects.length > 0 ? <Grid entries={projects} base="/personal" /> : <p class="empty">Proyectos en carga.</p>}
</Base>
