---
// Inicio: una sola foto, centrada, como en photobyjos.com
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { IMAGE_QUALITY } from '../site';
import foto from '../assets/inicio.jpg';

const og = await getImage({ src: foto, width: 1200, format: 'jpg' });
---

<Base image={og.src}>
  <div class="home">
    <Image
      src={foto}
      alt="Atardecer en Pucón"
      quality={IMAGE_QUALITY}
      widths={[800, 1200, 1800, 2500]}
      sizes="(min-width: 800px) 60vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</Base>
